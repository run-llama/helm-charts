# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Claude Code skills — shipped via the helm-charts git repo, not bundled
# into the runtime tarball that `helm install` downloads.
.claude/

# Generator config for values.schema.json (helm schema plugin) — build-time
# only. system-requirements.yaml is deliberately NOT ignored: it ships in the
# package so tooling can read the requirements for the exact chart version
# installed. (It is named system-requirements.yaml because helm strips the
# legacy v1 dependencies filename requirements.yaml from packages regardless.)
.schema.yaml

tests/
deployment_tests/
